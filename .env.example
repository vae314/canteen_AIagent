# 复制本文件为 .env，填写你自己的密钥后使用（.env 已在 .gitignore 中，不会被提交）

# ---- 视觉通道（图像理解）：任一 OpenAI 兼容端点，须带 /chat/completions 后缀 ----
VISION_API_URL=https://your-endpoint/chat/completions
VISION_API_KEY=sk-your-vision-key
VISION_MODEL=qwen-vl-plus

# ---- 文本通道（文字描述）：DeepSeek 开箱即用 ----
# TEXT_API_URL=https://api.deepseek.com/chat/completions
TEXT_API_KEY=sk-your-text-key
TEXT_MODEL=deepseek-chat

# ---- 可选：饮食日志保存路径（默认 meal_log.jsonl，不填即可）----
# MEAL_LOG_PATH=meal_log.jsonl